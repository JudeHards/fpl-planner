# Python's generated bytecode and test caches are reproducible locally.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Keep local environments, credentials and operating-system files out of Git.
.venv/
venv/
.env
.env.*
!.env.example
.DS_Store

# Reports and simulation JSON are intentionally versioned so findings can be reviewed.

# AIrsenal run output: progress-bar noise, regenerated on every run.
reports/airsenal-latest.log
